# Local mode is safe without paid-provider credentials. Send `transcript` in a test webhook.
PORT=3000
DATA_PATH=./data/etrainer.json
MIN_CALL_DURATION_SECONDS=60
# Keep false in production so missing duration cannot bypass the cost filter.
ALLOW_UNKNOWN_DURATION=false
JOB_MAX_ATTEMPTS=3
QUEUE_POLL_MS=1000
TRANSCRIPTION_PROVIDER=local
ANALYSIS_PROVIDER=local

# Enable only after validating a capped test account. Never commit real values.
# TRANSCRIPTION_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# ANALYSIS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# GHL writes are disabled by default. Enable only after review.
GHL_WRITE_ENABLED=false
# GHL_TOKEN=
# GHL_USER_ID=
# GHL_LOCATION_ID_SOLAR=
# GHL_LOCATION_ID_MITIGACION=
